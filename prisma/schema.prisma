generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Transaction {
  id                  String   @id @default(cuid())
  amount              Float
  country             String
  currency            String
  cardBin             String
  device              String
  fraudScore          Float
  failureScore        Float
  routeRecommendation String
  explanation         String
  createdAt           DateTime @default(now())
}